# ==============================================================================
# SEC Financial Data Pipeline & RAG System - Environment Variables
# Sao chép file này thành .env và điền giá trị thực tế vào
# CAUTION: Không bao giờ đặt key thật vào file này (file này được commit lên Git)
# ==============================================================================

# --- Gemini API (bắt buộc cho Bước 7 RAG Query) ---
# Lấy miễn phí tại: https://aistudio.google.com/apikey
GEMINI_API_KEY=your_gemini_api_key_here

# --- Cấu hình mô hình (tùy chọn, có giá trị mặc định) ---
EMBEDDING_MODEL=all-MiniLM-L6-v2
GEMINI_MODEL=gemini-3.6-flash
