# ==========================================
# SEC API Credentials
# ==========================================
SEC_API_KEY=your_sec_api_key_here

# ==========================================
# Database Configuration (PostgreSQL / Warehouse)
# ==========================================
DB_HOST=localhost
DB_PORT=5432
DB_NAME=stock_market_dw
DB_USER=postgres
DB_PASSWORD=postgres

# ==========================================
# Object Storage (MinIO / S3 / GCS)
# ==========================================
S3_ENDPOINT_URL=http://localhost:9000
S3_ACCESS_KEY=minioadmin
S3_SECRET_KEY=minioadmin
DATA_LAKE_BUCKET=stock-market-lake

# ==========================================
# Vector Database (Qdrant / Chroma / Milvus)
# ==========================================
VECTOR_DB_TYPE=qdrant
VECTOR_DB_HOST=localhost
VECTOR_DB_PORT=6333
VECTOR_COLLECTION_NAME=financial_reports

# ==========================================
# LLM & Embedding Service
# ==========================================
OPENAI_API_KEY=your_openai_api_key_here
EMBEDDING_MODEL=text-embedding-3-small
LLM_MODEL=gpt-4o-mini
