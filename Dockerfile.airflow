# ==============================================================================
# SEC Financial Data Pipeline & AI RAG System
# Custom Apache Airflow Docker Image with Data Engineering & AI Packages
# ==============================================================================

FROM apache/airflow:2.9.2-python3.10

USER root

# Cài đặt công cụ biên dịch tối thiểu cho các thư viện C/C++ (lxml, pyarrow,...)
RUN apt-get update \
    && apt-get install -y --no-install-recommends \
        build-essential \
        curl \
    && apt-get clean \
    && rm -rf /var/lib/apt/lists/*

USER airflow

# 1. Cài đặt PyTorch bản CPU siêu nhẹ trước để tránh tải gói GPU CUDA 600MB
RUN pip install --no-cache-dir torch --index-url https://download.pytorch.org/whl/cpu

# 2. Cài đặt các thư viện còn lại của pipeline
COPY requirements.txt /requirements.txt
RUN pip install --no-cache-dir -r /requirements.txt

# Thiết lập PYTHONPATH để Airflow tự động nhận diện module src.* của dự án
ENV PYTHONPATH="${PYTHONPATH}:/opt/airflow"
